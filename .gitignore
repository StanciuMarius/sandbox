
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
obj
bin
Properties/*
code/obj/*
code/Properties/*

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c

# Upstream keeps compiled shaders in the tree (!*.shader_c). We don't: they are
# rewritten byte-for-byte on most builds here, so they turn up in every diff and
# would collide on every merge. The editor recompiles them on load.
*.los
*.vpk
*launchSettings.json
*.sln

*idea

# Exported / standalone games
Exports/
*.user
*.slnx

# Agent env run artifacts - conclusions and screenshots, one folder per env.
.agent-runs/
