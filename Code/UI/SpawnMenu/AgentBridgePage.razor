@using Sandbox;
@using Sandbox.UI;
@inherits UtilityPage
@namespace Sandbox
@attribute [Icon( "🔌" )]
@attribute [Title( "#spawnmenu.utility.agent" )]
@attribute [Group( "#spawnmenu.utility.group.utilities" )]
@attribute [Order( 10 )]

<root class="page" style="flex-direction: column;">

    <div class="control-row" Tooltip=@EnabledDescription @onclick=@ToggleEnabled>
        <div class="left"><label>@(AgentBridge.Enabled ? "🟢" : "🔴") </label><label>#spawnmenu.utility.agent_enabled</label></div>
        <div style="flex-grow: 1;"></div>
        <label class="right">@(AgentBridge.Enabled ? "#spawnmenu.common.on" : "#spawnmenu.common.off")</label>
    </div>

    <div class="control-row">
        <div class="left"><label>@(AgentBridge.IsLinked ? "🔗" : "⚪") </label><label>#spawnmenu.utility.agent_status</label></div>
        <div style="flex-grow: 1;"></div>
        <label class="right">@StatusText</label>
    </div>

    <div class="section-header">#spawnmenu.utility.agent_setup</div>

    <div class="control-row" Tooltip=@CommandTooltip @onclick=@CopyCommand>
        <div class="left"><label>📋 </label><label>@CopyLabel</label></div>
    </div>

    <div class="control-row">
        <label class="left" style="font-size: 12px; opacity: 0.6;">@AgentCli.ReadmePath</label>
    </div>

</root>

@code
{
    static readonly string EnabledDescription = "#spawnmenu.utility.agent_enabled_description";
    static readonly string CommandTooltip = "#spawnmenu.utility.agent_copy_description";

    /// <summary>Reverts to the normal label a moment after copying.</summary>
    RealTimeSince timeSinceCopied = 1000f;

    bool JustCopied => timeSinceCopied < 2f;

    string CopyLabel => JustCopied ? "#spawnmenu.utility.agent_copied" : "#spawnmenu.utility.agent_copy";

    string StatusText => AgentBridge.IsLinked
        ? "#spawnmenu.utility.agent_connected"
        : AgentBridge.Enabled
            ? "#spawnmenu.utility.agent_waiting"
            : "#spawnmenu.common.off";

    void ToggleEnabled()
    {
        // a local preference, not a server setting - each player decides whether
        // their own client talks to an agent
        ConsoleSystem.Run( "sb.bridge", !AgentBridge.Enabled );

        if ( AgentBridge.Enabled )
            ConsoleSystem.Run( "bridge_connect" );

        StateHasChanged();
    }

    void CopyCommand()
    {
        // the prompt points the agent at the README rather than handing over a
        // bare command, so the player never has to explain the game themselves
        Clipboard.SetText( AgentCli.Prompt );
        timeSinceCopied = 0f;
        StateHasChanged();
    }

    protected override int BuildHash() => HashCode.Combine( AgentBridge.Enabled, AgentBridge.IsLinked, JustCopied, AgentCli.ReadmePath );
}
